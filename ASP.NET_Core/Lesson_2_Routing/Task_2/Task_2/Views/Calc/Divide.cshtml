@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Calculate</title>
</head>
<body>
    <p>
        @if (ViewBag.HasError)
        {
            <p style="color: red;">Помилка: @ViewBag.ErrorMessage</p>
        }
        else
        {
            <p>Результат: <strong>@ViewBag.Result</strong></p>
        }
    </body>
</html>
