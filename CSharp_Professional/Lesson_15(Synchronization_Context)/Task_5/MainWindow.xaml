<Window x:Class="Task_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_5"
        mc:Ignorable="d"
        Title="MainWindow" Height="192" Width="438">
    <Grid>
        <TextBox x:Name="MyTextBox" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="Натисни на кнопку щоб зроби &quot;ТИЦЬ&quot;..." VerticalAlignment="Top" Width="418" Height="100"/>
        <Button x:Name="MyButton" Content="Зроби &quot;ТИЦЬ&quot;" HorizontalAlignment="Center" Margin="0,124,0,0" VerticalAlignment="Top" Width="418" Height="42" Click="MyButton_Click"/>

    </Grid>
</Window>
